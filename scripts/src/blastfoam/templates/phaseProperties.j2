FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (c4 air);                // List of phases

{% for spec, molmass in spec_list %}
{{spec}}
{
    {#不需根據 FDS 轉換的固定參數#}
    type            detonating;
    
    reactants
    {
        thermoType
        {
            transport       const;
            thermo          eConst;
            equationOfState Murnaghan;
        }
        
        equationOfState
        {
            {%if is_explosive is defined%}rho0            {{reactants_rho0}};{%endif%}
            n               7.4;
            kappa           9.9e8;
            Gamma           0.35;
            pRef            101325;
        }
        
        specie
        {
            molWeight       {{molmass}};
        }
        
        thermodynamics
        {
            Cv              1400;
            Hf              0;
        }
        
        transport
        {
            mu              0;
            Pr              1;
        }
    }
    {#需根據 FDS 靜態轉換#}
    products
    {
        thermoType
        {
            transport       const;
            thermo          eConst;
            equationOfState JWL;
        }
        
        equationOfState
        {
            {%if is_explosive is defined%}rho0            {{reactants_rho0}};{%endif%}
            A               3.712e11;
            B               3.231e9;
            R1              4.15;
            R2              0.95;
            omega           0.30;
        }
        
        specie
        {
            molWeight       55;
        }
        
        thermodynamics
        {
            Cv              1400;
            Hf              0;
        }
        
        transport
        {
            mu              0;
            Pr              1;
        }
    }

    activationModel linear;
    {#根據 FDS 模擬開始後，偵測到爆炸才進行的動態轉換#}
    {%if is_explosive is defined%}initiation
    {
        
        E0              {{ E0_value }};
        Points          (( {{ trig_x }} {{ trig_y }} {{ trig_z }} ));
        vDet            {{ vDet_value }};
    {%endif%}}

    residualRho     1e-6;
    residualAlpha   1e-6;
}
{%endfor%}

air
{
    type basic;
    thermoType
    {
        transport   const;
        thermo      eConst;
        equationOfState idealGas;
    }
    equationOfState
    {
        gamma           1.4;            // Heat capactiy ratio
    }
    specie
    {
        molWeight       28.97;
    }
    transport
    {
        mu              0;
        Pr              1;
    }
    thermodynamics
    {
        type        eConst;
        Cv          718;
        Hf          0;
    }

    residualRho     1e-6;
    residualAlpha   1e-6;
}

// ************************************************************************* //
