&HEAD CHID='0928minyung', TITLE='Large Scale Fire Simulation with PLOT3D Output' /

&TIME T_END=3600.0 /

! === PLOT3D 輸出設定 ===
&DUMP DT_RESTART=300.0, DT_PL3D=10.0, DT_SLCF=10, WRITE_XYZ=.TRUE./ 
      
