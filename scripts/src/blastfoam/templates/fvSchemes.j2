FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme      {{ flux_scheme | default("Kurganov")}};

ddtSchemes
{
    default         Euler;
    timeIntegrator  RK2SSP {{time_integrator | default(3)}};
}

gradSchemes
{
    default         cellMDLimited leastSquares 1.0;
}

divSchemes
{
    default         none;
    {% for exp in explosive | default(["c4"]) %}
    div(alphaRhoPhi.{{exp}},lambda.{{exp}}) {{riemann_scheme | default("Riemann 0.5")}};
    {% endfor %}
    {% if extra_phases is defined %}
    {% for phase in extra_phases %}
    div(alphaRhoPhi.{{ phase }},lambda.{{ phase }}) {{ riemann_scheme | default('Riemann 0.5') }};
    {% endfor %}
    {% endif %}
    div(phi,k)      Gauss limitedLinear 1.0;
    div(phi,epsilon) Gauss limitedLinear 1.0;
    div(phi,omega)  Gauss limitedLinear 1.0;
}

laplacianSchemes
{
    default         Gauss linear corrected 0.5;
}

interpolationSchemes
{
    default             linear;
    reconstruct(alpha)  quadraticMUSCL Minmod;
    reconstruct(rho)    quadraticMUSCL Minmod;
    reconstruct(U)      quadraticMUSCL Minmod;
    reconstruct(e)      quadraticMUSCL Minmod;
    reconstruct(p)      quadraticMUSCL Minmod;
    reconstruct(speedOfSound)   quadraticMUSCL Minmod;

    reconstruct(lambda.c4) quadraticMUSCL Minmod;
}

snGradSchemes
{
    default         corrected;
}


// ************************************************************************* //
